---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getBrainEntries, tagHref } from "@/lib/content";

const entries = (await getBrainEntries()).filter(
  (entry) => entry.collection !== "rootPages" && entry.data.status !== "inbox",
);
const counts = new Map<string, number>();
for (const entry of entries) {
  for (const tag of entry.data.tags) {
    if (tag.startsWith("needs/")) continue;
    counts.set(tag, (counts.get(tag) || 0) + 1);
  }
}
const tags = [...counts.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0]),
);
---

<BaseLayout title="Tags" description="Browse Brain by its controlled vocabulary.">
  <main class="tags-page" data-pagefind-body>
    <header>
      <p>Controlled vocabulary</p>
      <h1 data-pagefind-meta="title">Tags</h1>
      <span>Browse the recurring subjects and visual categories across your Brain.</span>
    </header>
    <section class="tag-cloud" role="list">
      {
        tags.map(([tag, count]) => (
          <a href={tagHref(tag)} role="listitem">
            <span>{tag}</span>
            <strong class="tabular-nums">{count}</strong>
          </a>
        ))
      }
    </section>
  </main>
</BaseLayout>

<style>
  .tags-page {
    width: min(100% - 2rem, 72rem);
    margin-inline: auto;
    padding-block: 3rem 6rem;
  }

  header p {
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  header h1 {
    margin-top: 0.5rem;
    font-family: var(--font-serif);
    font-size: clamp(2.75rem, 7vw, 5rem);
    font-weight: 450;
    letter-spacing: -0.04em;
  }

  header span {
    display: block;
    margin-top: 0.75rem;
    color: var(--muted-foreground);
    font-size: 1.125rem;
  }

  .tag-cloud {
    display: grid;
    gap: 0.75rem;
    margin-top: 3rem;
  }

  .tag-cloud a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: color-mix(in oklab, var(--card) 70%, transparent);
  }

  .tag-cloud a:hover {
    border-color: var(--ring);
  }

  .tag-cloud strong {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 999px;
    background: var(--muted);
    color: var(--muted-foreground);
    font-size: 0.875rem;
    font-weight: 500;
  }

  @media (min-width: 42rem) {
    .tag-cloud {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .tag-cloud {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

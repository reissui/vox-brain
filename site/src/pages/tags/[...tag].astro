---
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  entryDate,
  entryHref,
  entryKind,
  entryTitle,
  formatDate,
  getBrainEntries,
  summaryFromBody,
} from "@/lib/content";

export async function getStaticPaths() {
  const entries = (await getBrainEntries()).filter(
    (entry) => entry.collection !== "rootPages",
  );
  const tags = [...new Set(entries.flatMap((entry) => entry.data.tags))].filter(
    (tag) => !tag.startsWith("needs/"),
  );
  return tags.map((tag) => ({ params: { tag }, props: { tag } }));
}

const { tag } = Astro.props as { tag: string };
const entries = (await getBrainEntries())
  .filter(
    (entry) =>
      entry.collection !== "rootPages" &&
      entry.data.status !== "inbox" &&
      entry.data.tags.includes(tag),
  )
  .sort((a, b) => (entryDate(b)?.valueOf() || 0) - (entryDate(a)?.valueOf() || 0));
---

<BaseLayout title={tag} description={`Knowledge tagged ${tag}.`}>
  <main class="tag-page" data-pagefind-body>
    <header>
      <a href="/tags">All tags</a>
      <h1 data-pagefind-meta="title">{tag}</h1>
      <p>{entries.length} {entries.length === 1 ? "knowledge item" : "knowledge items"}</p>
    </header>
    <section class="tag-results">
      {
        entries.map((entry) => (
          <a href={entryHref(entry)}>
            <div>
              <span>{entryKind(entry)}</span>
              <h2>{entryTitle(entry)}</h2>
              <p>{entry.data.description || summaryFromBody(entry.body) || "Open this knowledge item."}</p>
            </div>
            <time datetime={entryDate(entry)?.toISOString()}>{formatDate(entryDate(entry))}</time>
          </a>
        ))
      }
    </section>
  </main>
</BaseLayout>

<style>
  .tag-page {
    width: min(100% - 2rem, 68rem);
    margin-inline: auto;
    padding-block: 3rem 6rem;
  }

  header a {
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  header h1 {
    margin-top: 1rem;
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 450;
    letter-spacing: -0.04em;
  }

  header p {
    margin-top: 0.5rem;
    color: var(--muted-foreground);
  }

  .tag-results {
    display: grid;
    margin-top: 2.5rem;
  }

  .tag-results > a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.5rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .tag-results span {
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
  }

  .tag-results h2 {
    margin-top: 0.25rem;
    font-weight: 500;
  }

  .tag-results p {
    max-width: 68ch;
    margin-top: 0.35rem;
    overflow: hidden;
    color: var(--muted-foreground);
    font-size: 0.875rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tag-results time {
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .tag-results a:hover h2 {
    color: var(--accent);
  }
</style>

---
import { ArrowRight } from "@lucide/astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  entryDate,
  entryHref,
  entryKind,
  entryTitle,
  formatRelativeDate,
  getBrainEntries,
  projectSummary,
  summaryFromBody,
} from "@/lib/content";

const allEntries = await getBrainEntries();
const knowledge = allEntries.filter(
  (entry) =>
    entry.collection !== "rootPages" &&
    entry.collection !== "projectNotes" &&
    entry.data.status !== "inbox",
);
const designs = knowledge.filter((entry) => entry.data.type === "design");
const projects = allEntries
  .filter((entry) => entry.collection === "projectNotes")
  .map(projectSummary)
  .sort((a, b) => b.total - a.total);
const dated = knowledge
  .filter((entry) => entryDate(entry))
  .sort((a, b) => entryDate(b)!.valueOf() - entryDate(a)!.valueOf());
const recent = dated.slice(0, 7);
const latest = dated[0] ? entryDate(dated[0]) : undefined;
const waiting = projects.reduce(
  (total, project) => total + project.waiting + project.needsAttention,
  0,
);
const kinds = knowledge.reduce<Record<string, number>>((counts, entry) => {
  const kind = entryKind(entry);
  counts[kind] = (counts[kind] || 0) + 1;
  return counts;
}, {});
const kindSummary = Object.entries(kinds)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 5);
---

<BaseLayout title="Brain" description="A live overview of the owner’s private knowledge base.">
  <main class="dashboard" data-pagefind-body>
    <header class="dashboard-hero">
      <div>
        <p class="eyebrow">Knowledge workspace</p>
        <h1 data-pagefind-meta="title">Good to see you.</h1>
        <p>
          Your Brain currently holds <strong class="font-medium text-foreground">{knowledge.length}</strong>
          published knowledge items across <strong class="font-medium text-foreground">{projects.length}</strong>
          projects.
        </p>
      </div>
      <button class="hero-search" type="button" onclick="window.__openBrainSearch?.()">
        Search everything
        <span>⌘K</span>
      </button>
    </header>

    <section class="stats-container @container" aria-label="Brain statistics">
      <div class="stats-grid">
        <a href="/maps/INDEX" class="stat-card">
          <span class="truncate">Knowledge items</span>
          <strong class="tabular-nums">{knowledge.length}</strong>
          <small>{kindSummary.map(([kind, count]) => `${count} ${kind}`).join(" · ")}</small>
        </a>
        <a href="/designs" class="stat-card">
          <span class="truncate">Design references</span>
          <strong class="tabular-nums">{designs.length}</strong>
          <small>Thumbnail-first inspiration library</small>
        </a>
        <a href="/projects" class="stat-card">
          <span class="truncate">Active projects</span>
          <strong class="tabular-nums">
            {projects.filter((project) => project.status.toLowerCase() === "active").length}
          </strong>
          <small>{waiting ? `${waiting} items need attention` : "Everything processed"}</small>
        </a>
        <div class="stat-card">
          <span class="truncate">Last knowledge update</span>
          <strong class="stat-date">{formatRelativeDate(latest)}</strong>
          <small>{latest?.toLocaleDateString("en-GB", { dateStyle: "long" }) || "No dated notes yet"}</small>
        </div>
      </div>
    </section>

    <div class="dashboard-columns">
      <section class="dashboard-section">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Recently updated</p>
            <h2>What changed</h2>
          </div>
          <button type="button" onclick="window.__openBrainSearch?.()">View all</button>
        </div>
        <div class="recent-list">
          {
            recent.map((entry) => (
              <a href={entryHref(entry)} class="recent-row">
                <div>
                  <span>{entryKind(entry)}</span>
                  <h3>{entryTitle(entry)}</h3>
                  <p>{entry.data.description || summaryFromBody(entry.body) || "Open this knowledge item."}</p>
                </div>
                <time datetime={entryDate(entry)!.toISOString()}>
                  {formatRelativeDate(entryDate(entry))}
                </time>
              </a>
            ))
          }
        </div>
      </section>

      <aside class="dashboard-section projects-panel">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Project knowledge</p>
            <h2>Where things stand</h2>
          </div>
          <a href="/projects" aria-label="Open all projects"><ArrowRight class="size-5" /></a>
        </div>
        <div class="project-mini-list">
          {
            projects.slice(0, 6).map((project) => (
              <a href={entryHref(project.entry)} class="project-mini">
                <div>
                  <h3>{project.name}</h3>
                  <p>{project.status} · {project.total} connected items</p>
                </div>
                <span class="tabular-nums">{project.processed}</span>
              </a>
            ))
          }
        </div>
        <p class="project-note">
          Associations are detected from explicit project metadata and wikilinks during processing.
        </p>
      </aside>
    </div>
  </main>
</BaseLayout>

<style>
  .dashboard {
    width: min(100% - 2rem, 88rem);
    margin-inline: auto;
    padding-block: 3rem 5rem;
  }

  .dashboard-hero {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 1.5rem 3rem;
  }

  .eyebrow {
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .dashboard-hero h1 {
    margin-top: 0.75rem;
    font-family: var(--font-serif);
    font-size: clamp(2.75rem, 7vw, 5.75rem);
    font-weight: 450;
    letter-spacing: -0.045em;
  }

  .dashboard-hero p:last-child {
    max-width: 56ch;
    margin-top: 0.75rem;
    color: var(--muted-foreground);
    font-size: 1.125rem;
    line-height: 1.75rem;
    text-wrap: pretty;
  }

  .hero-search {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 1rem;
    min-height: 2.75rem;
    padding-inline: 1rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    color: var(--muted-foreground);
    cursor: pointer;
  }

  .hero-search:hover {
    border-color: var(--ring);
    color: var(--foreground);
  }

  .hero-search span {
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    background: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .stats-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: 1fr;
  }

  @container (min-width: 38rem) {
    .stats-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @container (min-width: 68rem) {
    .stats-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .stat-card {
    display: grid;
    min-height: 10rem;
    gap: 0.5rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: color-mix(in oklab, var(--card) 72%, transparent);
  }

  a.stat-card:hover {
    border-color: var(--ring);
  }

  .stat-card > span {
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .stat-card strong {
    align-self: end;
    font-family: var(--font-serif);
    font-size: 2.75rem;
    font-weight: 450;
    letter-spacing: -0.04em;
  }

  .stat-card strong.stat-date {
    font-size: 2rem;
  }

  .stat-card small {
    color: var(--muted-foreground);
    font-size: 0.75rem;
    line-height: 1rem;
  }

  .dashboard-columns {
    display: grid;
    gap: 2rem;
    margin-top: 3.5rem;
  }

  .dashboard-section {
    min-width: 0;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .section-heading h2 {
    margin-top: 0.35rem;
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 450;
  }

  .section-heading a,
  .section-heading button {
    color: var(--muted-foreground);
    font-size: 0.875rem;
    cursor: pointer;
  }

  .section-heading a:hover,
  .section-heading button:hover {
    color: var(--foreground);
  }

  .recent-list,
  .project-mini-list {
    display: grid;
  }

  .recent-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.5rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .recent-row > div > span {
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
  }

  .recent-row h3,
  .project-mini h3 {
    margin-top: 0.2rem;
    overflow: hidden;
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .recent-row p,
  .project-mini p {
    margin-top: 0.3rem;
    overflow: hidden;
    color: var(--muted-foreground);
    font-size: 0.875rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .recent-row time {
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .recent-row:hover h3,
  .project-mini:hover h3 {
    color: var(--accent);
  }

  .projects-panel {
    padding: 1.25rem;
    border-radius: 1rem;
    background: var(--card);
  }

  .project-mini {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .project-mini > span {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border-radius: 999px;
    background: var(--background);
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .project-note {
    padding-top: 1rem;
    color: var(--muted-foreground);
    font-size: 0.75rem;
    line-height: 1.125rem;
  }

  @media (min-width: 60rem) {
    .dashboard-columns {
      grid-template-columns: minmax(0, 3fr) minmax(20rem, 2fr);
    }
  }

  @media (max-width: 39.999rem) {
    .dashboard {
      padding-block: 1.5rem 4rem;
    }

    .dashboard-hero {
      display: grid;
      padding-bottom: 2rem;
    }

    .dashboard-hero h1 {
      font-size: 3.25rem;
    }

    .hero-search {
      justify-content: space-between;
    }

    .recent-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.5rem;
    }
  }
</style>

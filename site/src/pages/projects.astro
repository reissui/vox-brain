---
import { ArrowRight } from "@lucide/astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { entryHref, getBrainEntries, projectSummary } from "@/lib/content";

const projects = (await getBrainEntries())
  .filter((entry) => entry.collection === "projectNotes")
  .map(projectSummary)
  .sort((a, b) => {
    const active = Number(b.status.toLowerCase() === "active") - Number(a.status.toLowerCase() === "active");
    return active || b.total - a.total || a.name.localeCompare(b.name);
  });
const totalNotes = projects.reduce((sum, project) => sum + project.total, 0);
const waiting = projects.reduce((sum, project) => sum + project.waiting + project.needsAttention, 0);
---

<BaseLayout title="Projects" description="Project-centered views of connected knowledge and incoming captures.">
  <main class="projects-page" data-pagefind-body>
    <header class="projects-header">
      <p>Connected work</p>
      <h1 data-pagefind-meta="title">Projects</h1>
      <span>
        Every processed note, source, meeting, and explicitly routed capture contributes to the project it belongs to.
      </span>
    </header>

    <section class="project-stats @container" aria-label="Project statistics">
      <div class="project-stats-grid">
        <div>
          <span class="truncate">Projects</span>
          <strong class="tabular-nums">{projects.length}</strong>
        </div>
        <div>
          <span class="truncate">Connected knowledge</span>
          <strong class="tabular-nums">{totalNotes}</strong>
        </div>
        <div>
          <span class="truncate">Needs review</span>
          <strong class="tabular-nums">{waiting}</strong>
        </div>
      </div>
    </section>

    <label class="project-search">
      <span>Find a project</span>
      <input id="project-search" type="search" placeholder="Search by project or status…" />
    </label>

    <section class="project-grid" aria-label="Project knowledge areas">
      {
        projects.map((project) => (
          <a
            href={entryHref(project.entry)}
            class="project-card"
            data-project-card
            data-search={`${project.name} ${project.status}`.toLocaleLowerCase()}
          >
            <div class="project-card-head">
              <span>{project.status}</span>
              <ArrowRight class="size-5" />
            </div>
            <h2>{project.name}</h2>
            <p>{project.total} connected {project.total === 1 ? "item" : "items"}</p>
            <dl>
              <div>
                <dt>Processed</dt>
                <dd class="tabular-nums">{project.processed}</dd>
              </div>
              <div>
                <dt>Waiting</dt>
                <dd class="tabular-nums">{project.waiting}</dd>
              </div>
              <div>
                <dt>Attention</dt>
                <dd class="tabular-nums">{project.needsAttention}</dd>
              </div>
            </dl>
          </a>
        ))
      }
    </section>
    <div id="project-empty" class="project-empty" hidden={projects.length > 0}>
      No projects match that search.
    </div>

    <aside class="project-explainer">
      <div>
        <p>How association works</p>
        <h2>Automatic where possible, explicit where important.</h2>
      </div>
      <p>
        Brain connects knowledge through project metadata and wikilinks during processing. The same canonical project context remains searchable through the web index and the MCP project query.
      </p>
    </aside>
  </main>
</BaseLayout>

<script>
  const input = document.querySelector<HTMLInputElement>("#project-search");
  const cards = [...document.querySelectorAll<HTMLElement>("[data-project-card]")];
  const empty = document.querySelector<HTMLElement>("#project-empty");
  input?.addEventListener("input", () => {
    const query = input.value.trim().toLocaleLowerCase();
    let visible = 0;
    for (const card of cards) {
      card.hidden = Boolean(query && !card.dataset.search?.includes(query));
      if (!card.hidden) visible += 1;
    }
    if (empty) empty.hidden = visible > 0;
  });
</script>

<style>
  .projects-page {
    width: min(100% - 2rem, 82rem);
    margin-inline: auto;
    padding-block: 3rem 6rem;
  }

  .projects-header {
    max-width: 58rem;
  }

  .projects-header > p,
  .project-explainer > div > p {
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .projects-header h1 {
    margin-top: 0.5rem;
    font-family: var(--font-serif);
    font-size: clamp(2.75rem, 7vw, 5rem);
    font-weight: 450;
    letter-spacing: -0.04em;
  }

  .projects-header > span {
    display: block;
    max-width: 65ch;
    margin-top: 0.75rem;
    color: var(--muted-foreground);
    font-size: 1.125rem;
    line-height: 1.75rem;
    text-wrap: pretty;
  }

  .project-stats {
    margin-top: 2.5rem;
  }

  .project-stats-grid {
    display: grid;
    gap: 0.75rem;
  }

  .project-stats-grid > div {
    display: grid;
    min-height: 8rem;
    gap: 0.5rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: var(--card);
  }

  .project-stats-grid span {
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .project-stats-grid strong {
    align-self: end;
    font-family: var(--font-serif);
    font-size: 2.75rem;
    font-weight: 450;
  }

  @container (min-width: 38rem) {
    .project-stats-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .project-search {
    display: grid;
    max-width: 36rem;
    gap: 0.4rem;
    margin-top: 3rem;
  }

  .project-search span {
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .project-search input {
    min-height: 2.75rem;
    padding-inline: 0.9rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--background);
    outline: 0;
  }

  .project-search input:focus {
    border-color: var(--ring);
  }

  .project-grid {
    display: grid;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .project-card {
    display: grid;
    min-height: 17rem;
    gap: 0.6rem;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: color-mix(in oklab, var(--card) 72%, transparent);
  }

  .project-card[hidden] {
    display: none;
  }

  .project-card:hover {
    border-color: var(--ring);
  }

  .project-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--muted-foreground);
  }

  .project-card-head span {
    padding: 0.25rem 0.5rem;
    border-radius: 999px;
    background: var(--muted);
    font-size: 0.75rem;
  }

  .project-card h2 {
    align-self: end;
    overflow: hidden;
    font-family: var(--font-serif);
    font-size: 1.8rem;
    font-weight: 450;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .project-card > p {
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .project-card dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .project-card dl div {
    display: grid;
    gap: 0.2rem;
  }

  .project-card dt {
    overflow: hidden;
    color: var(--muted-foreground);
    font-size: 0.7rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .project-card dd {
    font-size: 1.15rem;
  }

  .project-empty {
    padding: 4rem 1rem;
    color: var(--muted-foreground);
    text-align: center;
  }

  .project-explainer {
    display: grid;
    gap: 1.5rem;
    margin-top: 4rem;
    padding: 1.5rem;
    border-radius: 1rem;
    background: var(--primary);
    color: var(--primary-foreground);
  }

  .project-explainer h2 {
    max-width: 24ch;
    margin-top: 0.5rem;
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 450;
    text-wrap: pretty;
  }

  .project-explainer > p {
    max-width: 60ch;
    color: color-mix(in oklab, var(--primary-foreground) 72%, transparent);
    line-height: 1.75rem;
    text-wrap: pretty;
  }

  @media (min-width: 42rem) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 68rem) {
    .project-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .project-explainer {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: end;
      padding: 2rem;
    }
  }
</style>

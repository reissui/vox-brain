---
import { ExternalLink } from "@lucide/astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  designCategories,
  entryDate,
  entryHref,
  entryTitle,
  formatDate,
  getBrainEntries,
  publicImagePath,
  summaryFromBody,
} from "@/lib/content";

const designs = (await getBrainEntries())
  .filter(
    (entry) =>
      entry.collection === "sources" &&
      entry.data.type === "design" &&
      !entry.data.tags.some((tag) => tag.startsWith("needs/")),
  )
  .sort((a, b) => (entryDate(b)?.valueOf() || 0) - (entryDate(a)?.valueOf() || 0));
const categories = [...new Set(designs.flatMap(designCategories))].sort();
---

<BaseLayout title="Design library" description="A thumbnail-led gallery of visual inspiration collected in Brain.">
  <main class="gallery-page" data-pagefind-body>
    <header class="gallery-header">
      <div>
        <p>Visual memory</p>
        <h1 data-pagefind-meta="title">Design library</h1>
        <span>
          Scan the images first. Open a reference when you want its context, visual analysis,
          or original source.
        </span>
      </div>
      <strong class="tabular-nums">{designs.length}</strong>
    </header>

    <div class="gallery-tools">
      <label>
        <span>Filter the gallery</span>
        <input id="design-search" type="search" placeholder="Search titles, tags, visual details…" />
      </label>
      <div class="gallery-filters" role="group" aria-label="Design categories">
        <button class="is-active" type="button" data-category="all" aria-pressed="true">All</button>
        {categories.map((category) => <button type="button" data-category={category}>{category}</button>)}
      </div>
    </div>

    <p id="design-count" class="gallery-count">{designs.length} visible references</p>
    <section class="design-wall" aria-label="Design inspiration gallery">
      {
        designs.map((design) => {
          const image = publicImagePath(design.data.image);
          const categories = designCategories(design);
          const summary = design.data.description || summaryFromBody(design.body);
          return (
            <article
              class="design-card"
              data-design-card
              data-tags={categories.join(" ").toLocaleLowerCase()}
              data-search={`${entryTitle(design)} ${categories.join(" ")} ${summary} ${design.body}`.toLocaleLowerCase()}
            >
              <a href={entryHref(design)} aria-label={`Open ${entryTitle(design)}`}>
                <figure>
                  {
                    image ? (
                      <img src={image} alt="" loading="lazy" />
                    ) : (
                      <div class="design-placeholder">Visual unavailable</div>
                    )
                  }
                </figure>
                <div class="design-card-copy">
                  <div>
                    <h2>{entryTitle(design)}</h2>
                    <time datetime={entryDate(design)?.toISOString()}>{formatDate(entryDate(design))}</time>
                  </div>
                  <p>{summary || "Open the visual index and capture context."}</p>
                  <div class="design-tags" role="list">
                    {categories.slice(0, 4).map((category) => <span role="listitem">{category}</span>)}
                  </div>
                </div>
              </a>
              {
                design.data.url && (
                  <a class="design-source" href={design.data.url} target="_blank" rel="noopener noreferrer">
                    Original <ExternalLink class="size-3.5" />
                  </a>
                )
              }
            </article>
          );
        })
      }
    </section>
    <div id="design-empty" class="gallery-empty" hidden={designs.length > 0}>
      No saved designs match this view.
    </div>
  </main>
</BaseLayout>

<script>
  const search = document.querySelector<HTMLInputElement>("#design-search");
  const cards = [...document.querySelectorAll<HTMLElement>("[data-design-card]")];
  const count = document.querySelector("#design-count");
  const empty = document.querySelector<HTMLElement>("#design-empty");
  const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-category]")];
  let category = "all";

  function filter() {
    const query = search?.value.trim().toLocaleLowerCase() || "";
    let visible = 0;
    for (const card of cards) {
      const categoryMatch = category === "all" || card.dataset.tags?.split(" ").includes(category);
      const queryMatch = !query || card.dataset.search?.includes(query);
      card.hidden = !(categoryMatch && queryMatch);
      if (!card.hidden) visible += 1;
    }
    if (count) count.textContent = `${visible} visible ${visible === 1 ? "reference" : "references"}`;
    if (empty) empty.hidden = visible > 0;
  }

  search?.addEventListener("input", filter);
  for (const button of buttons) {
    button.addEventListener("click", () => {
      category = button.dataset.category || "all";
      for (const candidate of buttons) {
        const active = candidate === button;
        candidate.classList.toggle("is-active", active);
        candidate.setAttribute("aria-pressed", String(active));
      }
      filter();
    });
  }
</script>

<style>
  .gallery-page {
    width: min(100% - 2rem, 100rem);
    margin-inline: auto;
    padding-block: 3rem 6rem;
  }

  .gallery-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: 2rem;
  }

  .gallery-header p {
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .gallery-header h1 {
    margin-top: 0.5rem;
    font-family: var(--font-serif);
    font-size: clamp(2.75rem, 6vw, 5rem);
    font-weight: 450;
    letter-spacing: -0.04em;
  }

  .gallery-header span {
    display: block;
    max-width: 60ch;
    margin-top: 0.75rem;
    color: var(--muted-foreground);
    font-size: 1.125rem;
    line-height: 1.75rem;
    text-wrap: pretty;
  }

  .gallery-header > strong {
    color: var(--muted-foreground);
    font-family: var(--font-serif);
    font-size: 3rem;
    font-weight: 400;
  }

  .gallery-tools {
    display: grid;
    gap: 1rem;
    padding-block: 1rem;
    border-block: 1px solid var(--border);
  }

  .gallery-tools label {
    display: grid;
    gap: 0.4rem;
  }

  .gallery-tools label span {
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .gallery-tools input {
    min-height: 2.75rem;
    padding-inline: 0.9rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--background);
    outline: 0;
  }

  .gallery-tools input:focus {
    border-color: var(--ring);
  }

  .gallery-filters {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 0.25rem;
  }

  .gallery-filters button {
    flex: none;
    padding: 0.5rem 0.75rem;
    border-radius: 999px;
    background: var(--muted);
    color: var(--muted-foreground);
    font-size: 0.875rem;
    cursor: pointer;
  }

  .gallery-filters button.is-active {
    background: var(--primary);
    color: var(--primary-foreground);
  }

  .gallery-count {
    padding-block: 1rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .design-wall {
    columns: 1;
    column-gap: 1rem;
  }

  .design-card {
    position: relative;
    break-inside: avoid;
    margin-bottom: 1rem;
    overflow: hidden;
    border-radius: 0.75rem;
    background: var(--card);
  }

  .design-card[hidden] {
    display: none;
  }

  .design-card figure {
    overflow: hidden;
    background: var(--muted);
  }

  .design-card img {
    width: 100%;
    height: auto;
    min-height: 13rem;
    object-fit: cover;
    outline: 1px solid rgb(0 0 0 / 0.06);
    outline-offset: -1px;
  }

  :global(.dark) .design-card img {
    outline-color: rgb(255 255 255 / 0.1);
  }

  .design-card a:first-child:hover img {
    transform: scale(1.015);
  }

  .design-card img {
    transition: transform 180ms ease-out;
  }

  .design-placeholder {
    display: grid;
    min-height: 16rem;
    place-items: center;
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .design-card-copy {
    display: grid;
    gap: 0.65rem;
    padding: 1rem;
  }

  .design-card-copy > div:first-child {
    display: grid;
    gap: 0.2rem;
  }

  .design-card h2 {
    overflow: hidden;
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .design-card time,
  .design-card p {
    color: var(--muted-foreground);
    font-size: 0.8rem;
  }

  .design-card p {
    display: -webkit-box;
    overflow: hidden;
    line-height: 1.2rem;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .design-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .design-tags span {
    padding: 0.2rem 0.45rem;
    border-radius: 999px;
    background: var(--background);
    color: var(--muted-foreground);
    font-size: 0.7rem;
  }

  .design-source {
    position: absolute;
    top: 0.65rem;
    right: 0.65rem;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.4rem 0.55rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--background) 88%, transparent);
    color: var(--foreground);
    backdrop-filter: blur(8px);
    font-size: 0.7rem;
  }

  .gallery-empty {
    padding: 4rem 1rem;
    color: var(--muted-foreground);
    text-align: center;
  }

  @media (min-width: 42rem) {
    .gallery-tools {
      grid-template-columns: minmax(18rem, 0.8fr) minmax(0, 1.2fr);
      align-items: end;
    }

    .design-wall {
      columns: 2;
    }
  }

  @media (min-width: 68rem) {
    .design-wall {
      columns: 3;
    }
  }

  @media (min-width: 88rem) {
    .design-wall {
      columns: 4;
    }
  }

  @media (max-width: 39.999rem) {
    .gallery-page {
      padding-block: 2rem 4rem;
    }

    .gallery-header strong {
      display: none;
    }
  }
</style>

---
import { getCollection, render } from "astro:content";
import WikiLayout from "@/layouts/WikiLayout.astro";
import { summaryFromBody } from "@/lib/content";

const pages = await getCollection("rootPages");
const entry = pages.find((page) => page.id === "bookmarks");
const rendered = entry ? await render(entry) : undefined;
const Content = rendered?.Content;
const headings = rendered?.headings ?? [];
---

<WikiLayout
  title={entry?.data.title || "Bookmarks"}
  description={
    entry?.data.description ||
    (entry ? summaryFromBody(entry.body) : "Saved links collected in your local Brain.")
  }
  kind="library"
  headings={headings}
  tags={entry?.data.tags ?? []}
>
  {
    Content ? (
      <Content />
    ) : (
      <>
        <h2>No bookmarks yet</h2>
        <p>
          Add a URL from the command line, then process the inbox to build this page from your
          own local content.
        </p>
        <pre><code>scripts/brain add "https://example.com" "Why this is worth keeping"
scripts/brain process</code></pre>
      </>
    )
  }
</WikiLayout>

<script>
  const root = document.querySelector<HTMLElement>("[data-library-kind]");
  const cards = [...document.querySelectorAll<HTMLElement>("[data-library-card]")];
  const search = document.querySelector<HTMLInputElement>("[data-library-search]");
  const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-library-filter]")];
  const count = document.querySelector<HTMLElement>("[data-library-count]");
  const empty = document.querySelector<HTMLElement>("[data-library-empty]");
  let filterValue = "all";

  function update() {
    const query = search?.value.trim().toLocaleLowerCase() || "";
    let visible = 0;
    for (const card of cards) {
      const filterMatch =
        filterValue === "all" || card.dataset.tags?.split(" ").includes(filterValue);
      const queryMatch = !query || card.dataset.search?.includes(query);
      card.hidden = !(filterMatch && queryMatch);
      if (!card.hidden) visible += 1;
    }
    if (count) count.textContent = `${visible} saved ${visible === 1 ? "bookmark" : "bookmarks"}`;
    if (empty) empty.style.display = visible ? "none" : "block";
    root?.setAttribute("data-filtered", "true");
  }

  search?.addEventListener("input", update);
  for (const button of buttons) {
    button.addEventListener("click", () => {
      filterValue = button.dataset.libraryFilter || "all";
      for (const candidate of buttons) {
        const active = candidate === button;
        candidate.classList.toggle("is-active", active);
        candidate.setAttribute("aria-pressed", String(active));
      }
      update();
    });
  }
</script>

---
import { Menu, Moon, Search, Sun } from "@lucide/astro";
import { SITE } from "@/lib/site";

const current = Astro.url.pathname;
const links = [
  { href: "/", label: "Overview" },
  { href: "/designs", label: "Designs" },
  { href: "/projects", label: "Projects" },
  { href: "/bookmarks", label: "Bookmarks" },
];
---

<header class="sticky top-0 z-40 border-b border-border/70 bg-background/90 backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-[96rem] items-center gap-4 px-4 sm:px-6">
    <button
      id="nav-toggle"
      class="icon-button lg:hidden"
      type="button"
      aria-label="Open navigation"
    >
      <Menu class="size-5" />
    </button>

    <a href="/" class="font-serif text-xl font-medium tracking-tight">{SITE.name}</a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={
              current === link.href ||
              (link.href !== "/" && current.startsWith(`${link.href}/`))
                ? "page"
                : undefined
            }
            class="nav-link"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <button
        class="search-button"
        type="button"
        onclick="window.__openBrainSearch?.()"
        aria-label="Search Brain"
      >
        <Search class="size-4" />
        <span class="hidden sm:inline">Search</span>
        <kbd class="hidden sm:inline">⌘K</kbd>
      </button>
      <button
        id="theme-toggle"
        class="icon-button"
        type="button"
        aria-label="Toggle colour theme"
      >
        <Sun class="size-4 dark:hidden" />
        <Moon class="hidden size-4 dark:block" />
      </button>
    </div>
  </div>
</header>

<dialog id="site-nav" class="mobile-nav-dialog">
  <div class="mobile-nav-panel">
    <div class="flex items-center justify-between border-b border-border p-4">
      <span class="font-serif text-xl font-medium">Browse Brain</span>
      <button class="icon-button" type="button" data-close-nav aria-label="Close navigation">×</button>
    </div>
    <nav class="grid gap-2 p-4" aria-label="Mobile">
      {
        links.map((link) => (
          <a href={link.href} class="mobile-nav-link">
            {link.label}
          </a>
        ))
      }
      <a href="/tags" class="mobile-nav-link">Tags</a>
      <a href="/maps/INDEX" class="mobile-nav-link">All knowledge</a>
    </nav>
  </div>
</dialog>

<script>
  const themeToggle = document.querySelector<HTMLButtonElement>("#theme-toggle");
  themeToggle?.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("brain-theme", dark ? "dark" : "light");
  });

  const siteNav = document.querySelector<HTMLDialogElement>("#site-nav");
  document.querySelector("#nav-toggle")?.addEventListener("click", () => {
    const wikiNav = document.querySelector<HTMLDialogElement>("#mobile-wiki-nav");
    (wikiNav || siteNav)?.showModal();
  });
  document.querySelectorAll("[data-close-nav]").forEach((button) => {
    button.addEventListener("click", () => {
      siteNav?.close();
      document.querySelector<HTMLDialogElement>("#mobile-wiki-nav")?.close();
    });
  });
  siteNav?.addEventListener("click", (event) => {
    if (event.target === siteNav) siteNav.close();
  });
</script>

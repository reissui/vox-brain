---
import { Search, X } from "@lucide/astro";
---

<dialog id="brain-search" class="search-dialog">
  <div class="search-shell">
    <div class="search-field">
      <Search class="size-5 shrink-0 text-muted-foreground" />
      <input
        id="brain-search-input"
        type="search"
        placeholder="Search notes, sources, projects…"
        autocomplete="off"
      />
      <button class="icon-button" type="button" data-search-close aria-label="Close search">
        <X class="size-4" />
      </button>
    </div>
    <p id="brain-search-status" class="search-status">Start typing to search your Brain.</p>
    <div id="brain-search-results" class="search-results" role="list"></div>
  </div>
</dialog>

<script is:inline type="module">
  const dialog = document.querySelector("#brain-search");
  const input = document.querySelector("#brain-search-input");
  const results = document.querySelector("#brain-search-results");
  const status = document.querySelector("#brain-search-status");
  let pagefind;

  async function openSearch() {
    dialog?.showModal();
    requestAnimationFrame(() => input?.focus());
    if (!pagefind) {
      try {
        pagefind = await import("/pagefind/pagefind.js");
        await pagefind.init();
      } catch {
        if (status) status.textContent = "Search becomes available after a full production build.";
      }
    }
  }

  window.__openBrainSearch = openSearch;
  document.querySelector("[data-search-close]")?.addEventListener("click", () => dialog?.close());
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
  document.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      void openSearch();
    }
  });

  let searchVersion = 0;
  input?.addEventListener("input", async () => {
    const version = ++searchVersion;
    const query = input.value.trim();
    if (!results || !status) return;
    results.replaceChildren();
    if (!query) {
      status.textContent = "Start typing to search your Brain.";
      return;
    }
    if (!pagefind) return;
    status.textContent = "Searching…";
    const search = await pagefind.search(query);
    const data = await Promise.all(search.results.slice(0, 10).map((result) => result.data()));
    if (version !== searchVersion) return;
    status.textContent = `${search.results.length} ${search.results.length === 1 ? "result" : "results"}`;
    for (const item of data) {
      const link = document.createElement("a");
      link.className = "search-result";
      link.href = item.url;
      const title = document.createElement("strong");
      title.textContent = item.meta?.title || item.url;
      const excerpt = document.createElement("span");
      excerpt.innerHTML = item.excerpt || "";
      link.append(title, excerpt);
      results.append(link);
    }
  });
</script>

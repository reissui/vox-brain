---
import { Menu, X } from "@lucide/astro";
import WikiNav from "@/components/WikiNav.astro";
import BaseLayout from "./BaseLayout.astro";
import { formatDate, tagHref } from "@/lib/content";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  kind?: string;
  date?: Date;
  headings?: Heading[];
  tags?: string[];
  image?: string;
}

const {
  title,
  description,
  kind = "note",
  date,
  headings = [],
  tags = [],
  image,
} = Astro.props;
const toc = headings.filter((heading) => heading.depth > 1 && heading.depth < 5);
---

<BaseLayout {title} {description} {image}>
  <div class="wiki-grid">
    <aside class="wiki-sidebar">
      <div class="wiki-sticky"><WikiNav /></div>
    </aside>

    <main class="min-w-0 py-8 sm:py-12" data-pagefind-body>
      <header class="article-header">
        <div class="flex flex-wrap items-center gap-2 text-base text-muted-foreground sm:text-sm">
          <span class="kind-pill">{kind}</span>
          {date && <time datetime={date.toISOString()}>{formatDate(date)}</time>}
        </div>
        <h1 data-pagefind-meta="title">{title}</h1>
        {description && <p>{description}</p>}
        {
          tags.length > 0 && (
            <div class="tag-row" role="list">
              {tags.map((tag) => (
                <a href={tagHref(tag)} role="listitem">
                  {tag}
                </a>
              ))}
            </div>
          )
        }
      </header>
      <article class="prose max-w-[76ch]">
        <slot />
      </article>
    </main>

    <aside class="toc-sidebar">
      <div class="wiki-sticky">
        {
          toc.length > 0 ? (
            <>
              <p class="sidebar-label">On this page</p>
              <nav class="toc" aria-label="Table of contents">
                {toc.map((heading) => (
                  <a href={`#${heading.slug}`} data-depth={heading.depth}>
                    {heading.text}
                  </a>
                ))}
              </nav>
            </>
          ) : (
            <p class="toc-empty">A focused reading view with no outline needed.</p>
          )
        }
      </div>
    </aside>
  </div>

  <dialog id="mobile-wiki-nav" class="mobile-nav-dialog">
    <div class="mobile-nav-panel">
      <div class="flex items-center justify-between border-b border-border p-4">
        <span class="font-serif text-xl font-medium">Knowledge</span>
        <button class="icon-button" type="button" data-close-nav aria-label="Close navigation">
          <X class="size-4" />
        </button>
      </div>
      <div class="overflow-y-auto p-4"><WikiNav /></div>
    </div>
  </dialog>

  <button
    class="floating-nav lg:hidden"
    type="button"
    onclick="document.querySelector('#mobile-wiki-nav')?.showModal()"
    aria-label="Browse knowledge"
  >
    <Menu class="size-5" />
    Browse
  </button>
</BaseLayout>

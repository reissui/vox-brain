{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "decision": { "type": "string", "enum": ["none", "upsert", "remove"] },
    "kind": { "type": "string", "enum": ["communication", "workflow", "context", "routine"] },
    "instruction": { "type": "string" },
    "applies_when": { "type": "string" },
    "evidence": { "type": "string" },
    "replace_ids": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 20
    }
  },
  "required": ["decision", "kind", "instruction", "applies_when", "evidence", "replace_ids"],
  "additionalProperties": false
}

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>app.voxbrain.telegram</string>
  <key>ProgramArguments</key><array>
    <string>@PYTHON@</string><string>@BOT@</string><string>run</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>@PATH@</string>
    <key>BRAIN_SOURCE_ROOT</key><string>@SOURCE_ROOT@</string>
    <key>BRAIN_DATA_ROOT</key><string>@DATA_ROOT@</string>
    <key>BRAIN_STATE_DIR</key><string>@STATE_DIR@</string>
    <key>BRAIN_TELEGRAM_MODEL</key><string>@MODEL@</string>
    <key>BRAIN_TELEGRAM_LEARNING_MODEL</key><string>@LEARNING_MODEL@</string>
    <key>BRAIN_SITE_URL</key><string>@SITE_URL@</string>
  </dict>
  <key>StandardOutPath</key><string>/tmp/app.voxbrain.telegram.log</string>
  <key>StandardErrorPath</key><string>/tmp/app.voxbrain.telegram.log</string>
</dict></plist>

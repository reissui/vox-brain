<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>app.voxbrain.site-publisher</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>set -a; . "$1"; set +a; exec "$2" "$3" --config "$4" --process-marker "$5"</string>
    <string>app.voxbrain.site-publisher</string>
    <string>@PUBLISHER_ENV_FILE@</string>
    <string>@PYTHON@</string>
    <string>@PUBLISHER@</string>
    <string>@CONFIG@</string>
    <string>@PROCESS_MARKER@</string>
  </array>
  <key>WorkingDirectory</key>
  <string>@WORKING_DIRECTORY@</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>@HOME@</string>
    <key>PATH</key>
    <string>@PATH@</string>
    <key>BRAIN_DATA_ROOT</key>
    <string>@DATA_ROOT@</string>
    <key>BRAIN_SOURCE_ROOT</key>
    <string>@CODE_ROOT@</string>
  </dict>
  <key>WatchPaths</key>
  <array>
    <string>@PROCESS_MARKER@</string>
  </array>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>Umask</key>
  <integer>63</integer>
  <key>StandardOutPath</key>
  <string>@STDOUT@</string>
  <key>StandardErrorPath</key>
  <string>@STDERR@</string>
</dict>
</plist>

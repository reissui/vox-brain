{
  "manifest_version": 3,
  "name": "Brain Clipper",
  "version": "1.0.0",
  "description": "Save pages, selections, links, tweets, and design references directly to the owner's Brain.",
  "permissions": ["activeTab", "clipboardRead", "contextMenus", "notifications", "scripting", "storage"],
  "host_permissions": [
    "https://*.workers.dev/*",
    "https://pbs.twimg.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Save to Brain",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
